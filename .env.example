# Server settings for `npm run dev` and `npm run preview`.
#
# Copy this file to .env.local and edit it. .env.local is gitignored, so your
# settings stay on your machine:
#
#     cp .env.example .env.local
#
# Every line is optional. Leave one commented out to keep its default. A variable
# set in the shell wins over this file, e.g. ASK_TRIAGE_PORT=8080 npm run dev.

# Where the register is saved. Relative paths are from the repo root. Keep it
# out of the repo, or under data/ (gitignored): it holds real asks.
# Default: data/register.json
# ASK_TRIAGE_DATA_FILE=data/register.json

# Which address to listen on. 0.0.0.0 listens on every interface, so you can
# open the app from another machine, e.g. over Tailscale.
# Default: localhost only
# ASK_TRIAGE_HOST=0.0.0.0

# Which port to listen on, for both dev and preview. The server refuses to
# start rather than quietly picking another port if this one is busy.
# Default: 5173 for dev, 4173 for preview
# ASK_TRIAGE_PORT=5173
